# Local development defaults. Copy to .env only if you want to override them.
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

DB_USER=user
DB_PASSWORD=pass

CUSTOMER_DB_URL=jdbc:postgresql://localhost:5432/customerdb
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/productdb
ORDER_DB_URL=jdbc:postgresql://localhost:5432/orderdb
AUTH_DB_URL=jdbc:postgresql://localhost:5432/authdb

CUSTOMER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083

JPA_DDL_AUTO=update
CLIENT_CONNECT_TIMEOUT_MS=3000
CLIENT_READ_TIMEOUT_MS=5000

JWT_SECRET=change-this-local-secret-change-this-local-secret
JWT_EXPIRATION_MS=3600000

AUTH_SEED_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=user123
